<?xml version="1.0" encoding="utf-8"?>
<!--
    Allows cleartext HTTP to the Android emulator host alias only.
    10.0.2.2 is the emulator's loopback alias for the host machine (Mac).
    This config must NOT be used in production builds.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
